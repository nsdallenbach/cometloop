# Staging environment — a second instance of this stack beside prod, in the
# same subscription. Copy to staging.tfvars (git-ignored) and apply with its
# own state key:
#
#   terraform init -reconfigure -backend-config="key=azure.staging.tfstate"
#   terraform apply -var-file=staging.tfvars
#
# (With local state, use a separate workspace instead: `terraform workspace
# new staging` before the apply.) Names come out as cometloop-staging-*;
# .github/workflows/deploy.yml derives the same names from the environment.
environment      = "staging"
custom_domain    = "staging.cometloop.ai"
# Scale to zero when nobody is testing: ~USD 2–6/month instead of ~35.
api_min_replicas = 0
api_max_replicas = 2
# Neon `staging` branch (project misty-water-72985311) — Auth URL from the
# Neon console → Auth, or `neon neon-auth status`. The branch's JWKS URL is
# the Key Vault secret `neon-auth-jwks-url`; DATABASE_URL is the branch's
# pooled connection string.
neon_auth_base_url = "https://ep-curly-unit-b5qfj8cm.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth"
# After the first apply + the Cloudflare records, flip on for the certificate:
# custom_domain_enabled = true
