# Production — copy to prod.tfvars (git-ignored). State key aws.prod.tfstate.
environment   = "prod"
image_tag     = "production"
custom_domain = "app.cometloop.ai"
cpu           = "512"
memory        = "1024"
min_tasks     = 1
max_tasks     = 3
neon_auth_base_url = "https://ep-curly-forest-b5c0naxn.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth"
# bootstrap_placeholder_image = false   # after the first production deploy
