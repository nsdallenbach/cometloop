# Staging — copy to staging.tfvars (git-ignored). State key aws.staging.tfstate.
#
#   terraform init                                    # S3 backend: -backend-config="key=aws.staging.tfstate" (versions.tf)
#   terraform apply -var-file=staging.tfvars
#
environment   = "staging"
image_tag     = "staging"
custom_domain = "staging.cometloop.ai"
# Smallest Fargate task: 0.25 vCPU / 512 MiB, one task always on.
cpu       = "256"
memory    = "512"
min_tasks = 1
max_tasks = 2
# Neon `staging` branch (project misty-water-72985311) — Auth URL from the
# Neon console → Branches → staging → Auth, or `neon neon-auth status`. The
# branch's JWKS URL is the SSM parameter neon-auth-jwks-url; DATABASE_URL
# is the branch's pooled connection string.
neon_auth_base_url = "https://ep-curly-unit-b5qfj8cm.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth"
# After the first deploy has pushed the `staging` tag, flip to false and
# apply again; ECS rolls the service onto the real image:
# bootstrap_placeholder_image = false
