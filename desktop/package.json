    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.546.0",
    "node-pty": "^1.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vite": "^5.4.11"
  }
