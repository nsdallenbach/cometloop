{
  "name": "cometloop-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cometloop desktop client — local runner host with the console's look and feel",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
