{
  "name": "cometloop-desktop",
  "version": "0.3.3",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Cometloop desktop client — local runner host with the console's look and feel",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "build:staging": "cross-env COMETLOOP_CHANNEL=staging electron-vite build",
    "dist:staging": "npm run build:staging && electron-builder --config electron-builder.staging.yml",
    "dist:win:staging": "npm run build:staging && electron-builder --win --config electron-builder.staging.yml",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.546.0",
    "node-pty": "^1.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "cross-env": "^10.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vite": "^8.3.5"
  }
}
