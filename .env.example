# Local development — see README "Local development — web console" for where
# each value comes from. Auth is the Databricks CLI's DEFAULT profile.
#
# Portable runtime (docs/local-dev.md): set DATABASE_URL and every Databricks
# variable below becomes optional — plain Postgres, no workspace token.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Neon: also set the direct endpoint (same URL, "-pooler" removed from the
# host) so each request pins one connection instead of a transaction per
# statement. See docs/local-dev.md.
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require
# FILES_DIR=data/files
# PORT=8000
DATABRICKS_HOST=https://...
DATABRICKS_APP_NAME=delivery-console
DATABRICKS_APP_PORT=8000

# UC volumes (databricks.yml → resources.volumes)
DATABRICKS_VOLUME_FILES=/Volumes/<catalog>/<schema>/sow_docs
DATABRICKS_VOLUME_TELEMETRY=/Volumes/<catalog>/<schema>/agent_telemetry

# Model serving endpoint (databricks.yml → serving_endpoint_name). With the
# workspace SP pair (DATABRICKS_CLIENT_ID / DATABRICKS_CLIENT_SECRET, injected
# by Databricks Apps) and no ANTHROPIC_API_KEY, a workspace with no provider
# gets this endpoint auto-registered as its model provider on first use.
DATABRICKS_SERVING_ENDPOINT_NAME=your_serving_endpoint_name

# Model providers (docs/platform-architecture.md §6). Providers are configured
# per workspace under Admin → Model providers; a row names its credential by
# the NAME of an environment variable (local) or Key Vault secret (prod) —
# never the value. With ANTHROPIC_API_KEY set, a workspace with no provider
# gets an Anthropic provider registered automatically with every role mapped
# (planning/review → claude-sonnet-5, estimate/draft → claude-haiku-4-5-20251001).
ANTHROPIC_API_KEY=
# Azure Key Vault URL: credential refs not found in the environment are read
# from here through DefaultAzureCredential (managed identity / az login).
AZURE_KEY_VAULT_URL=
# Cloudflare AI Gateway base (https://gateway.ai.cloudflare.com/v1/<account>/<gateway>).
# When set, provider calls route through it with cf-aig-metadata tagging the
# workspace, role, flow and ticket; a provider row can opt out (bypassGateway).
AI_GATEWAY_URL=

# Lakebase (databricks postgres get-endpoint <LAKEBASE_ENDPOINT> -o json → .status.hosts.host)
LAKEBASE_ENDPOINT=projects/<project>/branches/<branch>/endpoints/<endpoint>
PGHOST=your_postgres_host
PGDATABASE=your_postgres_databaseName
PGPORT=5432
PGSSLMODE=require

# LOCAL DEVELOPMENT ONLY: stand-in identity when no Apps proxy sets the
# x-forwarded-* headers. Without it every /api call is 401 (fail closed).
# Never set this on a deployed app.
DEV_IDENTITY_EMAIL=

# Better Auth / Neon Auth JWT verification (optional; off when unset).
NEON_AUTH_JWKS_URL=

# Workflows — the Decide node (docs/workflows.md). Jev is TypeSafe's decision
# model; without a key the node falls through to Databricks ai_decide (needs
# the workspace SP above plus a SQL warehouse), then to the configured model.
TYPESAFE_API_KEY=
DATABRICKS_WAREHOUSE_ID=

# GitHub App (optional locally; app.yaml + secret scope delivery-console).
# Without both, repo sync / PR linking / git-credential vending are off.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# First console admin: on boot this email is added to the default tenant as
# 'owner' (idempotent). Needed once for a fresh database; later members are
# added through /api/admin/members.
# BOOTSTRAP_OWNER_EMAIL=you@example.com
