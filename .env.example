# Local development — see README "Local development — web console" for where
# each value comes from. Auth is the Databricks CLI's DEFAULT profile.
DATABRICKS_HOST=https://...
DATABRICKS_APP_NAME=delivery-console
DATABRICKS_APP_PORT=8000

# UC volumes (databricks.yml → resources.volumes)
DATABRICKS_VOLUME_FILES=/Volumes/<catalog>/<schema>/sow_docs
DATABRICKS_VOLUME_TELEMETRY=/Volumes/<catalog>/<schema>/agent_telemetry

# Model serving endpoint (databricks.yml → serving_endpoint_name)
DATABRICKS_SERVING_ENDPOINT_NAME=your_serving_endpoint_name

# Lakebase (databricks postgres get-endpoint <LAKEBASE_ENDPOINT> -o json → .status.hosts.host)
LAKEBASE_ENDPOINT=projects/<project>/branches/<branch>/endpoints/<endpoint>
PGHOST=your_postgres_host
PGDATABASE=your_postgres_databaseName
PGPORT=5432
PGSSLMODE=require

# GitHub App (optional locally; app.yaml + secret scope delivery-console).
# Without both, repo sync / PR linking / git-credential vending are off.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
