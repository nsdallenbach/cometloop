{
  "name": "cometloop",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "cross-env NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "dev:local": "cross-env NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env.local ./server/server.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run && npm run test:smoke",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "clean": "rm -rf client/dist dist build node_modules .smoke-test test-results playwright-report",
    "postinstall": "npm run typegen",
    "prebuild": "npm run sync && npm run typegen",
    "predev": "npm run sync && npm run typegen",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "setup": "appkit setup --write"
  },
  "keywords": [],
  "author": "",
  "license": "Unlicensed",
  "description": "Cometloop - delivery execution console: portfolio, board, roadmap, sources, team, status feed",
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/keyvault-secrets": "^4.11.2",
    "@databricks/appkit": "0.38.1",
    "@databricks/appkit-ui": "0.38.1",
    "@databricks/sdk-experimental": "0.17.0",
    "@number-flow/react": "^0.6.2",
    "@visx/curve": "^4.0.0",
    "@visx/event": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/pattern": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "animejs": "^4.5.0",
    "clsx": "2.1.1",
    "d3-array": "^3.2.4",
    "d3-shape": "^3.2.0",
    "dompurify": "^3.4.13",
    "embla-carousel-react": "8.6.0",
    "jose": "^6.2.12",
    "lucide-react": "0.546.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "motion": "^13.1.0",
    "next-themes": "0.4.6",
    "pg": "8.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "3.0.6",
    "react-router": "7.13.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "unpdf": "^1.6.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.37.0",
    "@eslint/compat": "2.0.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "4.1.17",
    "@types/d3-array": "^3.2.2",
    "@types/d3-shape": "^3.1.8",
    "@types/express": "5.0.5",
    "@types/node": "24.6.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "pg-mem": "^3.0.14",
    "prettier": "3.6.2",
    "sharp": "0.34.5",
    "tailwindcss": "4.0.14",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "4.0.14"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
